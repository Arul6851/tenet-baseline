# Control plane database. Use actual local credentials or a pooled deployment URL.
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/tenet
# AWS RDS endpoints are detected automatically and use sslmode=require when
# the URL does not already specify an SSL mode.

# Server-only OpenAI configuration. Never expose this key through NEXT_PUBLIC_ variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Public control-plane URL and server-side token pepper for future repository tokens.
TENET_APP_URL=http://localhost:3000
TENET_TOKEN_PEPPER=replace-with-a-long-random-secret

# `tenet check` synchronization is repository-local and opt-in:
# tenet connect --url http://localhost:3000 --repository commerce-platform --repo examples/ecommerce
