# Control plane database. Use a pooled PostgreSQL connection string in deployment.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tenet

# Server-only OpenAI configuration. Never expose this key through NEXT_PUBLIC_ variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Public control-plane URL and server-side token pepper for future repository tokens.
TENET_APP_URL=http://localhost:3000
TENET_TOKEN_PEPPER=replace-with-a-long-random-secret
